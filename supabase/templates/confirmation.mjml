<mjml lang="en">
  <mj-head>
    <mj-title>TeaDesk</mj-title>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="24px" color="#525252" align="left" padding="0 0 16px 0" />
    </mj-attributes>
    <mj-style> .break-all a { word-break: break-all; } </mj-style>
    <mj-raw> <meta name="color-scheme" content="light" /> <meta name="supported-color-schemes" content="light" /> </mj-raw>
  </mj-head>
  <mj-body background-color="#fafafa" width="570px">
    <mj-wrapper background-color="#ffffff" border="1px solid #e4e4e4" border-radius="4px" padding="32px">
      <mj-section padding="0">
        <mj-column>
          <mj-text font-size="20px" color="#181818"> Confirm your email address </mj-text>
          <mj-text> Use the code below to confirm your email address and finish creating your account. </mj-text>
          <mj-text align="center">
            <span style="font-family: monospace, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 32px; font-weight: bold; color: #181818; background-color: #fafafa; border: 2px dashed #000000; padding: 16px; border-radius: 16px; display: inline-block;">{{ .Token }}</span>
          </mj-text>
          <mj-text> This code will expire in 1 hour. Do not share it with anyone. </mj-text>
          <mj-text> If you did not create an account, you can safely ignore this email. </mj-text>
          <mj-text> Regards,<br />TeaDesk </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
